      "id": "decimal-fraction",
      "sourceKeyAttribute": "Decimal Fraction",
      "labels": {
        "en": "Decimal Fraction",
        "es": "Fracción decimal"
      },
      "definitions": {
        "en": "A fraction in which the denominator is a power of 10. The fractions 8/10 and 74/100 are fractions that can be written as decimal fractions: 8/10 = 0.8 and 74/100 = 0.74. Decimal fractions are often referred to only as \"decimals.\"",
