  "corrections": [
    {
      "id": "fixed-target-grading",
      "source": "Button166 accepts equality of txtChr_1+txtChr_2 and txtIP_1+txtIP_2, regardless of target25 and ignoring hundreds.",
      "counterexamples": [
        {
          "shaded": 15,
          "input": [
            "1",
            "5"
          ],
          "sourceCorrect": true,
          "productCorrect": false
        },
        {
          "shaded": 0,
          "input": [
            "0",
            "0"
          ],
          "sourceCorrect": true,
          "productCorrect": false
        },
        {
          "shaded": 100,
          "input": [
            "0",
            "0"
          ],
          "sourceCorrect": true,
          "productCorrect": false
        }
      ],
      "product": "Require25shaded AND input digits2,5. Preserve raw source grader as diagnostic, never learner grading.",
      "reason": "Question explicitly targets25/100 and final authored caption says25%; mathematical correctness."
    },
    {
      "id": "assisted-hundred-reset",
      "source": "Second wrong sets only tens/ones to2,5; txtChr_F can remain1, which forces100bluecells. mcDragX is read in coach terminal but never assigned in this SWF.",
      "product": "Set grid25 and both input digits2,5, position thumb by inverse source scale. Assisted result remains distinct from a learner-correct result.",
      "reason": "Keep the source second-attempt reveal coherent with25/100; do not depend on absent host globals."
    },
    {
      "id": "answer-clip-entry",
      "source": "Answer189 is placed main177 but stops at child1. Red25grid begins child2; no page AS calls ANSWER_MC.play/gotoAndPlay.",
      "product": "Explicitly enter the source-backed red25grid when main resumes/outro begins, with transparent correction evidence.",
      "reason": "Display the authored25%conclusion with its matching source diagram; original runtime unresolved."
    },
    {
      "id": "percent-input-semantics",
      "source": "Two source inputs have no maxLength/restrict; a third read-only field displays hundreds. Percent symbol absent in static stage.",
      "product": "Two labeled single-digit native inputs and explicit percent label; 0..100slider including endpoint100 remains independently usable.",
      "reason": "Make the intended two-digit percent entry and mathematical quantity unambiguous and accessible."
    }
  ],
