import{ALG_L07_{{PAGE_UPPER}}_SOURCE as S}from'./alg-l07-{{PAGE_LOWER}}-source-v1';
export{ALG_L07_{{PAGE_UPPER}}_SOURCE}from'./alg-l07-{{PAGE_LOWER}}-source-v1';
export type {{PAGE_UPPER}}Term={{TERM_UNION}};
export interface {{PAGE_UPPER}}State{
 epoch:number;replay:number;cycle:number;mainFrame:number;phase:'prequiz'|'quiz-held'|'feedback'|'postquiz'|'left';playing:boolean;
 slope:string;attempts:number;quizSection:boolean;drawEnabled:boolean;sliderEnabled:boolean;
 popupVisible:boolean;popupFrame:number;popupSerial:number;wrongText:string|null;glossary:{{PAGE_UPPER}}Term|null;lessonCompleted:false;
}
export type {{PAGE_UPPER}}Event=({type:'play'|'pause'|'submit'|'close-feedback'|'close-glossary'|'replay'|'leave'}|{type:'advance-main'|'advance-feedback';frame:number}|{type:'drag';x:number}|{type:'open-glossary';term:{{PAGE_UPPER}}Term})&{epoch:number};
export function {{PAGE_LOWER}}InitialState(epoch=0,replay=0):{{PAGE_UPPER}}State{return{epoch,replay,cycle:0,mainFrame:1,phase:'prequiz',playing:false,slope:'{{INITIAL}}',attempts:0,quizSection:false,drawEnabled:false,sliderEnabled:false,popupVisible:false,popupFrame:1,popupSerial:0,wrongText:null,glossary:null,lessonCompleted:false};}
export function {{PAGE_LOWER}}Visual(frame:number){if(!Number.isSafeInteger(frame)||frame<1||frame>{{LAST}})throw Error('{{PAGE_UPPER}}_MAIN_FRAME');return S.visualStates.find(s=>frame>=s.first&&frame<=s.last)!.value;}
/** The authored drag bounds apply before the enterFrame expression. */
export function {{PAGE_LOWER}}SlopeAtX(x:number){if(!Number.isFinite(x))throw Error('{{PAGE_UPPER}}_SLIDER_POSITION');const bounded=Math.max(-150,Math.min(50,x));return String(Math.round((bounded/10+5)*10)/10);}
export function {{PAGE_LOWER}}CanPlay(s:{{PAGE_UPPER}}State){return!s.glossary&&(s.phase==='prequiz'||s.phase==='postquiz'||s.phase==='feedback'&&s.popupFrame<{{FEEDBACK_LAST}});}
export function {{PAGE_LOWER}}CanDraw(s:{{PAGE_UPPER}}State){return {{DRAW_PHASE}}&&s.drawEnabled&&!s.glossary&&!s.popupVisible;}
export function {{PAGE_LOWER}}Reduce(s:{{PAGE_UPPER}}State,e:{{PAGE_UPPER}}Event):{{PAGE_UPPER}}State{
 if(e.epoch!==s.epoch||s.phase==='left')return s;
 if(e.type==='replay'||e.type==='leave')return{...{{PAGE_LOWER}}InitialState(s.epoch+1,s.replay+(e.type==='replay'?1:0)),phase:e.type==='leave'?'left':'prequiz'};
 if(e.type==='pause')return s.playing?{...s,playing:false}:s;
 if(e.type==='play')return {{PAGE_LOWER}}CanPlay(s)&&!s.playing?{...s,playing:true}:s;
 if(e.type==='open-glossary')return!s.glossary&&{{PAGE_LOWER}}Visual(s.mainFrame).terms.some(t=>t===e.term)?{...s,glossary:e.term,playing:false}:s;
 if(e.type==='close-glossary')return s.glossary?{...s,glossary:null,playing:false}:s;
 if(s.glossary)return s;
 if(e.type==='advance-main'){
  if(!s.playing||!['prequiz','postquiz'].includes(s.phase)||!Number.isSafeInteger(e.frame)||e.frame<=s.mainFrame||e.frame>{{AFTER_LAST}})return s;
  if(s.phase==='prequiz'&&e.frame>={{QUIZ}})return{...s,phase:'quiz-held',mainFrame:{{QUIZ}},playing:false,slope:'{{INITIAL}}',attempts:0,quizSection:true,drawEnabled:true,sliderEnabled:true,popupVisible:false,popupFrame:1};
  if(e.frame==={{AFTER_LAST}})return{...s,phase:'prequiz',mainFrame:1,cycle:s.cycle+1,drawEnabled:false,sliderEnabled:false,popupVisible:false};
  return{...s,mainFrame:e.frame,slope:e.frame>={{FORCED}}?'{{CORRECT}}':s.slope,drawEnabled:{{POST_DRAW_FLAG}},sliderEnabled:false};
 }
 if(e.type==='drag'){
  if(s.phase!=='quiz-held'||!s.sliderEnabled||s.popupVisible||!Number.isFinite(e.x))return s;
  const slope={{PAGE_LOWER}}SlopeAtX(e.x);return slope===s.slope?s:{...s,slope};
 }
 if(e.type==='submit'){
  if(!{{PAGE_LOWER}}CanDraw(s))return s;
{{POST_SUBMIT}}  const attempts=s.attempts+1,correct=s.slope==='{{CORRECT}}';
  return{...s,attempts,drawEnabled:false,sliderEnabled:false,playing:true,phase:correct?'postquiz':'feedback',quizSection:!correct,
   ...(correct?{}:{popupVisible:true,popupFrame:2,popupSerial:s.popupSerial+1,wrongText:attempts===1?S.behavior.wrongFirst:S.behavior.wrongLater})};
 }
 if(e.type==='advance-feedback'){
  if(s.phase!=='feedback'||!s.popupVisible||!s.playing||!Number.isSafeInteger(e.frame)||e.frame<=s.popupFrame||e.frame>{{FEEDBACK_LAST}})return s;
  return{...s,popupFrame:e.frame,playing:e.frame<{{FEEDBACK_LAST}}};
 }
 if(e.type==='close-feedback'){
  if(s.phase!=='feedback'||!s.popupVisible||s.popupFrame<2)return s;
  const proceed=s.attempts>=2;
  // Source Close re-enables the flags before parent.play(). Native controls
  // accept exercise events only while quiz-held, before that continuation.
  return{...s,phase:proceed?'postquiz':'quiz-held',popupVisible:false,popupFrame:2,playing:proceed,quizSection:!proceed,drawEnabled:true,sliderEnabled:true};
 }
 return s;
}
