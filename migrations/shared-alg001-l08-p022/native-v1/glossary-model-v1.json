    {
      "id": "opposite",
      "sourceKeyAttribute": "Opposite",
      "labels": {
        "en": "Opposite",
        "es": "Opuesto"
      },
      "definitions": {
        "en": "Having a position directly across from each other. For example: on a number line positive 1 is the opposite of negative 1 because they are both the same distance from 0 but in different directions.",
        "es": "Que tiene una posición opuesta a otra. Por ejemplo: en la recta numérica el 1 positivo (+1) es el opuesto de 1 negativo (-1) porque ambos se encuentran a la misma distancia del 0 pero en diferente dirección."
      },
      "source": {
