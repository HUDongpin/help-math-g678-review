    {
      "id": "point",
      "sourceKeyAttribute": "Point",
      "labels": {
        "en": "Point",
        "es": "Punto"
      },
      "definitions": {
        "en": "A point is a geometric figure that has position, but no length, width, or height.",
        "es": "Un punto es una figura geométrica que tiene una posición, pero no tiene dimensiones: longitud, anchura o altura."
      },
      "source": {
