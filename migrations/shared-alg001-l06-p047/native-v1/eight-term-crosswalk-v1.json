    {
      "id": "coordinate",
      "sourceKeyAttribute": "Coordinate",
      "labels": {
        "en": "Coordinate",
        "es": "Coordenada"
      },
      "definitions": {
        "en": "A coordinate is the ordered pair of numbers that correspond to a point on a graph.",
        "es": "Una coordenada es un par ordenado de números que corresponden a un punto en un gráfico."
      },
      "source": {
