    {
      "id": "numerator",
      "sourceKeyAttribute": "Numerator",
      "labels": {
        "en": "Numerator",
        "es": "Numerador"
      },
      "definitions": {
        "en": "The top number in a fraction. For example: 1 is the numerator in 1/2.",
        "es": "Es el número ubicado en la parte superior de un quebrado o fracción. Por ejemplo: en el caso de 1/2, el 1 es el numerador."
      },
