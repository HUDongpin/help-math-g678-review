    {
      "id": "value",
      "sourceKeyAttribute": "Value",
      "labels": {
        "en": "Value",
        "es": "Valor"
      },
      "definitions": {
        "en": "This is what something is worth in terms of something else. In math, value refers to the size expressed by a number. For example: the value of 4 is four units, four things or objects.",
        "es": "En matemáticas, se refiere a la magnitud expresada en un número. Así por ejemplo; el valor de 4 es cuatro unidades, cuatro cosas o objetos. Ver Valor posicional."
      },
