    {
      "id": "domain",
      "sourceKeyAttribute": "Domain",
      "labels": {
        "en": "Domain",
        "es": "Dominio"
      },
      "definitions": {
        "en": "The domain of a function is the set of all the function’s inputs.",
        "es": "El dominio de una función es el conjunto de todos los valores de entrada de esa función."
      },
      "source": {
