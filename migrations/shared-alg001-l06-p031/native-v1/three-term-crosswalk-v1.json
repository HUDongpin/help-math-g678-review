    {
      "id": "calculate",
      "sourceKeyAttribute": "Calculate",
      "labels": {
        "en": "Calculate",
        "es": "Calcular"
      },
      "definitions": {
        "en": "To find an approximate value. For example: you can estimate the sum of 123 + 789 as about 900. To calculate also means to evaluate. For example, 2 + 4 + 6 evaluates to 12.",
        "es": "Encontrar un valor aproximado. Por ejemplo: usted puede calcular la suma de 123 + 789 como más o menos 900. Calcular también significa evaluar. Por ejemplo, evaluamos 2 + 4 + 6 como igual a 12."
      },
      "source": {
        "en": {
