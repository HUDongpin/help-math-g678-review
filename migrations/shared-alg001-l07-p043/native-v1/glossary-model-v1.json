    {
      "id": "coefficient",
      "sourceKeyAttribute": "Coefficient",
      "labels": {
        "en": "Coefficient",
        "es": "Coeficiente"
      },
      "definitions": {
        "en": "A number that is placed before and multiplies a variable or algebraic expression. For example: 4 is the coefficient in 4y.",
        "es": "El número que se coloca delante y multiplica una variable o expresión algebraica. Por ejemplo: 4 es el coeficiente en la expresión 4y."
      },
