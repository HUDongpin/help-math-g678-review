    {
      "id": "baseball",
      "sourceKeyAttribute": "Baseball",
      "labels": {
        "en": "Baseball",
        "es": "Béisbol"
      },
      "definitions": {
        "en": "A sport common in North America in which the object is to strike a ball so that one of a nine-person team can run counter-clockwise among four bases, causing a run.",
        "es": "Deporte común en los Estados Unidos en el que el objetivo es golpear una pelota de manera tal que un jugador del equipo, compuesto por 9 jugadores, pueda correr en sentido contrario a las agujas del reloj alrededor de cuatro bases y anotar una carrera."
      },
      "source": {
