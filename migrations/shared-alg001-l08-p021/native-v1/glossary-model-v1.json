    {
      "id": "length",
      "sourceKeyAttribute": "Length",
      "labels": {
        "en": "Length",
        "es": "Longitud"
      },
      "definitions": {
        "en": "How long something is or the distance from one end to another. You can measure length using the “standard units of measurement”: meters, centimeters, kilometers, inches, feet and yards.",
        "es": "Es el largo de un objeto o la distancia de un lado a otro. Se puede medir la longitud usando “unidades estándares de medición” como: metros, centímetros, kilómetros, pulgadas, pies y yardas."
      },
      "source": {
