    {
      "id": "fraction",
      "sourceKeyAttribute": "Fraction",
      "labels": {
        "en": "Fraction",
        "es": "Fracción"
      },
      "definitions": {
        "en": "Part of a whole, number or group. For example, 1/4 means one of a group of four. Fractions also show division. For example, the fraction 1/4 means \"one divided by four.\"",
        "es": "Parte de un todo, de un número o grupo. Por ejemplo: 1/4 significa uno de un grupo de cuatro. Las fracciones también indican división. Por ejemplo: la fracción 1/4 significa \"uno dividido entre cuatro.\""
      },
      "source": {
