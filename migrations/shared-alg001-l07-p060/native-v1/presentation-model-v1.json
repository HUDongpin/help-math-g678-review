,"key":"Coordinate","firstFrame":1,"lastFrame":1},{"ownerSpriteId":358,"buttonId":277,"key":"Coordinate","firstFrame":827,"lastFrame":1029},{"ownerSpriteId":289,"buttonId":278,"key":"Right triangle","firstFrame":1,"lastFrame":21},{"ownerSpriteId":342,"buttonId":278,"key":"Right triangle","firstFrame":1,"lastFrame":1},{"ownerSpriteId":358,"buttonId":278,"key":"Right triangle","firstFrame":827,"lastFrame":1029},{"ownerSpriteId":342,"buttonId":337,"key":"Ratio","firstFrame":1,"lastFrame":1},{"ownerSpriteId":342,"buttonId":338,"key":"Vertical","firstFrame":1,"lastFrame":1},{"ownerSpriteId":342,"buttonId":339,"key":"Horizontal","firstFrame":1,"lastFrame":1},{"ownerSpriteId":342,"buttonId":340,"key":"Point","firstFrame":1,"lastFrame":1},{"ownerSpriteId":342,"buttonId":341,"key":"Axis","firstFrame":1,"lastFrame":1}],"ending":"source-stop"},"texts":[{"characterId":16,"sourceTextId":"character-16","text":"The graph shows how many dollars (D) are in Gina’s checking account as a function of how many weeks (W) have passed. The graph increases every week because Gina’s mom gives her an allowance, and Gina does not spend the money. Calculate the slope of the line to see what Gina’s weekly allowance is."},{"characterId":25,"sourceTextId":"character-25","text":"2."},{"characterId":26,"sourceTextId":"character-26","text":"3."},{"characterId":27,"sourceTextId":"character-27","text":"4."},{"characterId":28,"sourceTextId":"character-28","text":"."},{"characterId":29,"sourceTextId":"character-29","text":"1"},{"characterId":182,"sourceTextId":"character-182","text":"5"},{"characterId":185,"sourceTextId":"character-185","text":"6"},{"characterId":188,"sourceTextId":"character-188","text":"7"},{"characterId":191,"sourceTextId":"character-191","text":"10"},{"characterId":217,"sourceTextId":"character-217","text":"What is the slope of the line?"},{"characterId":259,"sourceTextId":"character-259","text":"Information given: A graph of a linear function;  "},{"characterId":260,"sourceTextId":"character-260","text":"Information needed: what is the slope?"},{"characterId":264,"sourceTextId":"character-264","text":"Use Strategy:  Write an equation and solve it."},{"characterId":265,"sourceTextId":"character-265","text":"Choose two points whose coordinates are obvious."},{"characterId":266,"sourceTextId":"character-266","text":"Use (0,20) and (10,80)."},{"characterId":267,"sourceTextId":"character-267","text":"Form a right triangle using those points and the line."},{"characterId":268,"sourceTextId":"character-268","text":"The vertical length of the triangle is 60."},{"characterId":269,"sourceTextId":"character-269","text":"The horizontal length is 10."},{"characterId":270,"sourceTextId":"character-270","text":"Slope equals vertical length of change divided by horizontal length of change."},{"characterId":271,"sourceTextId":"character-271","text":"Slope = 6"},{"characterId":273,"sourceTextId":"character-273","text":"Slope = "},{"characterId":274,"sourceTextId":"character-274","text":"vertical change         80 – 20      60       6"},{"characterId":275,"sourceTextId":"character-275","text":"horizontal change       10 – 0        10       1"},{"characterId":276,"sourceTextId":"character-276","text":"="},{"characterId":292,"sourceTextId":"character-292","text":"4."},{"characterId":293,"sourceTextId":"character-293","text":"Strategy:  Work backwards"},{"characterId":294,"sourceTextId":"character-294","text":"Let slope = 6"},{"characterId":295,"sourceTextId":"character-295","text":"Choose a different point (20,140) on the line."},{"characterId":296,"sourceTextId":"character-296","text":"Use the point (0,20)"},{"characterId":298,"sourceTextId":"character-298","text":"Slope = 6 = "},{"characterId":299,"sourceTextId":"character-299","text":"vertical change        140 – 20       120      6"},{"characterId":300,"sourceTextId":"character-300","text":"horizontal change       20 – 0          20       1"},{"characterId":301,"sourceTextId":"character-301","text":"="},{"characterId":310,"sourceTextId":"character-310","text":"Slope is the ratio of the vertical change to the horizontal change of a linear function."},{"characterId":311,"sourceTextId":"character-311","text":"To calculate the slope, choose two points whose coordinates are obvious."},{"characterId":312,"sourceTextId":"character-312","text":"Use (0, 20) and (10, 80)."},{"characterId":313,"sourceTextId":"character-313","text":"Next, form a right triangle using those points and the graph."},{"characterId":314,"sourceTextId":"character-314","text":"Slope equals the vertical change in length of this triangle divided by the horizontal change in length."},{"characterId":315,"sourceTextId":"character-315","text":"Calculate each of those lengths using the numbers shown on the axes. Then divide."},{"characterId":316,"sourceTextId":"character-316","text":"Slope = "},{"characterId":317,"sourceTextId":"character-317","text":"vertical change"},{"characterId":318,"sourceTextId":"character-318","text":"horizontal change"}],"question":{"characterId":16,"sourceTextId":"character-16","text":"The graph shows how many dollars (D) are in Gina’s checking account as a function of how many weeks (W) have passed. The graph increases every week because Gina’s mom gives her an allowance, and Gina does not spend the money. Calculate the slope of the line to see what Gina’s weekly allowance is."},"answers":[{"letter":"A","instance":"AnsBtn4","characterId":306,"labelId":181,"valueId":182,"equation":{"kind":"plain","text":"5","sourceIds":[182]}},{"letter":"B","instance":"AnsBtn1","characterId":305,"labelId":184,"valueId":185,"equation":{"kind":"plain","text":"6","sourceIds":[185]}},{"letter":"C","instance":"AnsBtn3","characterId":306,"labelId":187,"valueId":188,"equation":{"kind":"plain","text":"7","sourceIds":[188]}},{"letter":"D","instance":"AnsBtn2","characterId":306,"labelId":190,"valueId":191,"equation":{"kind":"plain","text":"10","sourceIds":[191]}}],"steps":[{"number":1,"numberIds":[28,29],"textIds":