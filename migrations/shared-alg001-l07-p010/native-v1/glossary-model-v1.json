    {
      "id": "rise",
      "sourceKeyAttribute": "Rise",
      "labels": {
        "en": "Rise",
        "es": "Elevación"
      },
      "definitions": {
        "en": "The rise is the vertical distance between two points on a line. A line with a positive slope will rise uphill from left to right.",
        "es": "La elevación es la distancia vertical entre dos puntos de una línea. Una línea con pendiente positiva se elevará de izquierda a derecha."
      },
      "source": {
