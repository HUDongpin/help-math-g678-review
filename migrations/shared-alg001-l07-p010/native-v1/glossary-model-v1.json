      "labels": {
        "en": "Horizontal",
        "es": "Horizontal"
      },
      "definitions": {
        "en": "Parallel to or in the plane of the horizon. A horizontal line goes right and left. The horizon is horizontal.",
        "es": "Paralelo o en el mismo plano que el horizonte. Una línea horizontal va hacia la izquierda y hacia la derecha."
      },
