    {
      "id": "line",
      "sourceKeyAttribute": "Line",
      "labels": {
        "en": "Line",
        "es": "Línea"
      },
      "definitions": {
        "en": "A line is a straight set of points stretching in opposite directions without end.",
        "es": "Una línea es un conjunto continuo de puntos que se extienden en direcciones opuestas sin final."
