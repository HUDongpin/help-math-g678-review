    {
      "id": "run",
      "sourceKeyAttribute": "Run",
      "labels": {
        "en": "Run",
        "es": "Distancia horizontal"
      },
      "definitions": {
        "en": "The run is the horizontal distance between two points on a line. A vertical line has an undefined slope because between any two points there is no run.",
        "es": "La distancia es el trazo horizontal entre dos puntos en una línea. Una línea vertical tiene pendiente indefinida porque entre dos puntos no hay distancia horizontal."
      },
      "source": {
