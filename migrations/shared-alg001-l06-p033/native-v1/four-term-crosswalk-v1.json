    {
      "id": "function",
      "sourceKeyAttribute": "Function",
      "labels": {
        "en": "Function",
        "es": "Función"
      },
      "definitions": {
        "en": "A special relation in which every value of x has one, and only one, value of y.",
        "es": "Relación especial en la cual a cada valor x le corresponde solamente un valor y."
      },
      "source": {
