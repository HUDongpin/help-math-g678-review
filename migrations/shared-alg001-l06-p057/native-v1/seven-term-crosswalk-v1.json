    {
      "id": "relation",
      "sourceKeyAttribute": "Relation",
      "labels": {
        "en": "Relation",
        "es": "Relación"
      },
      "definitions": {
        "en": "A set of ordered pairs. Relations can be expressed using words, tables, lists of ordered pairs, graphs, or an algebraic rule or equation.",
        "es": "Un conjunto de pares ordenados. Las relaciones pueden ser expresadas por medio de palabras, tablas, listas de pares ordenados, gráficos, una regla algebraica o una ecuación."
      },
