    {
      "id": "output",
      "sourceKeyAttribute": "Output",
      "labels": {
        "en": "Output",
        "es": "Salida"
      },
      "definitions": {
        "en": "In mathematics, output refers to the result of the action of input, putting data in.",
        "es": "En matemáticas, salida se refiere al acto obtener datos como resultado de ejecutar ciertas operaciones en una función."
      },
