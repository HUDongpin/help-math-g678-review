    {
      "id": "function-table",
      "sourceKeyAttribute": "Function table",
      "labels": {
        "en": "Function table",
        "es": "Tabla de la función"
      },
      "definitions": {
        "en": "A function table is a table that shows pairs of inputs and outputs for the function.",
        "es": "Una tabla de una función es una tabla que muestra los pares de entradas y salidas para esa función."
      },
