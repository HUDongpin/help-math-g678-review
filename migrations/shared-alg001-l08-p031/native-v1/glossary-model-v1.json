37c529494dafbcf2d83ff55f53047f4cca6408a2d7","es":"04ca990e99821c237052b0e5d4bc9fcf7df46d5b45e2fa4f02d600027134779e"},"extractionLfNormalizedEntrySha256":{"en":"1953b79992cc007771895437c529494dafbcf2d83ff55f53047f4cca6408a2d7","es":"04ca990e99821c237052b0e5d4bc9fcf7df46d5b45e2fa4f02d600027134779e"}},{"id":"exponent","sourceKeyAttribute":"Exponent","labels":{"en":"Exponent","es":"Exponente"},"definitions":{"en":"The small number above and to the right of a base number which shows the number of times the base number is multiplied by itself. For example: 4³, 3 is the exponent and means 4 x 4 x 4. An exponent is also called a power.","es":"Es el número, pequeñito, que escribimos en la parte de arriba y a la derecha de otro número, llamado número base, que muestra la cantidad de veces en que el número base tiene que multiplicarse por sí mismo. Por ejemplo: en 4³, 3 es el exponente y significa que el cuatro se multiplica a si mismo: 4 x 4 x 4. Un exponente también es llamado \"potencia\"."},"source":{"en":{"assetId":"G678L1KTE01.xml","path":"HELP_KEYTERMS/KT/XML/L1KTE01.xml","sha256":"14d454f4c1c1a6f0939fb80b454fd3e22890eabb4a730c6bfa7efa1d9a2e5e5b"},"es":{"assetId":"G678L1KTS01.xml","path":"HELP_KEYTERMS/KT/XML/L1KTS01.xml","sha256":"3b437b42e75536fa8b4f110325e366c27fbe10a871439d4797650cda4238b407"}},"sourceEntrySha256":{"en":"d33ab7fc8db94c0f54c9c3e4329034913d456021630b12d7638c7b9622f9977b","es":"839ab785f9795cfe457519a7d721db28dce1f96c49070bd558c7ff065ae815f1"},"extractionLfNormalizedEntrySha256":{"en":"d33ab7fc8db94c0f54c9c3e4329034913d456021630b12d7638c7b9622f9977b","es":"01c7d923c5ba8c138774822480cb44b6570c29fb202c2688862177ba2cb93fdd"}},{"id":"fraction","sourceKeyAttribute":"Fraction","labels":{"en":"Fraction","es":"Fracción"},"definitions":{"en":"Part of a whole, number or group. For example, 1/4 means one of a group of four. Fractions also show division. For example, the fraction 1/4 means \"one divided by four.\"","es":"Parte de un todo, de un número o grupo. Por ejemplo: 1/4 significa uno de un grupo de cuatro. Las fracciones también indican división. Por ejemplo: la fracción 1/4 significa \"uno dividido entre cuatro.\""},"source":{"en":{"assetId":"G678L1KTE01.xml","path":"HELP_KEYTERMS/KT/XML/L1KTE01.xml","sha256":"14d454f4c1c1a6f0939fb80b454fd3e22890eabb4a730c6bfa7efa1d9a2e5e5b"},"es":{"assetId":"G678L1KTS01.xml","path":"HELP_KEYTERMS/KT/XML/L1KTS01.xml","sha256":"3b437b42e75536fa8b4f110325e366c27fbe10a871439d4797650cda4238b407"}},"sourceEntrySha256":{"en":"da3b8c4844487baed54e2e54a62261e90d818aabef34f83b25ada596e525925a","es":"9b042985b90bf81b7c010398a1017373037ce2068d4f81190890bf5d767150cb"},"extractionLfNormalizedEntrySha256":{"en":"da3b8c4844487baed54e2e54a62261e90d818aabef34f83b25ada596e525925a","es":"9b042985b90bf81b7c010398a1017373037ce2068d4f81190890bf5d767150cb"}},{"id":"linear-equation","sourceKeyAttribute":"Linear equation","labels":{"en":"Linear equation","es":"Ecuación lineal"},"definitions":{"en":"A linear equation is an equation whose graph is a straight line.","es":"Una ecuación lineal es una ecuación cuya gráfica es una línea recta."},"source":{"en":{"assetId":"G678L1KTE01.xml","path":"HELP_KEYTERMS/KT/XML/L1KTE01.xml","sha256":"14d454f4c1c1a6f0939fb80b454fd3e22890eabb4a730c6bfa7efa1d9a2e5e5b"},"es":{"assetId":"G678L1KTS01.xml","path":"HELP_KEYTERMS/KT/XML/L1KTS01.xml","sha256":"3b437b42e75536fa8b4f110325e366c27fbe10a871439d4797650cda4238b407"}},"sourceEntrySha256":{"en":"f1a62fde5914d4e5af521a318d905538635f4c2f356620a40948a22e6aec0bc5","es":"88335361f0fc3a79bee019ef7ebf9a667f1321945cfecd0858f0ab447e4bd16b"},"extractionLfNormalizedEntrySha256":{"en":"f1a62fde5914d4e5af521a318d905538635f4c2f356620a40948a22e6aec0bc5","es":"88335361f0fc3a79bee019ef7ebf9a667f1321945cfecd0858f0ab447e4bd16b"}},{"id":"term","sourceKeyAttribute":"Term","labels":{"en":"Term","es":"Término"},"definitions":{"en":"Each number or object in an equation, pattern or sequence is called a term. A term can be a number, a variable, or a product or quotient of numbers and variables.","es":"Cada número u objeto en una ecuación, modelo o secuencia se denomina término. Un término puede ser un número, una variable, un producto o un cociente de números y variables."},"source":{"en":{"assetId":"G678L1KTE01.xml","path":"HELP_KEYTERMS/KT/XML/L1KTE01.xml","sha256":"14d454f4c1c1a6f0939fb80b454fd3e22890eabb4a730c6bfa7efa1d9a2e5e5b"},"es":{"assetId":"G678L1KTS01.xml","path":"HELP_KEYTERMS/KT/XML/L1KTS01.xml","sha256":"3b437b42e75536fa8b4f110325e366c27fbe10a871439d4797650cda4238b407"}},"sourceEntrySha256":{"en":"0ea9683ac40c5ca5d9a9ffd4edaf93434d189913ed584e3276974ab4eaeb101e","es":"bbef55f0daaa16ae7687b972d2609798289c3bb8719abd480a00c6fbfdfeba06"},"extractionLfNormalizedEntrySha256":{"en":"0ea9683ac40c5ca5d9a9ffd4edaf93434d189913ed584e3276974ab4eaeb101e","es":"bbef55f0daaa16ae7687b972d2609798289c3bb8719abd480a00c6fbfdfeba06"}},{"id":"variable","sourceKeyAttribute":"Variable","labels":{"en":"Variable","es":"Variable"},"definitions":{"en":"A letter or symbol that stands for one or more numbers. For example: x is the variable in 2x.","es":"Una letra o símbolo que está tomando el valor de uno o más números. Por ejemplo: x es la variable en la expresión 2x."},"source":{"en":{"assetId":"G678L1KTE01.xml","path":"HELP_KEYTERMS/KT/XML/L1KTE01.xml","sha256":"14d454f4c1c1a6f0939fb80b454fd3e22890eabb4a730c6bfa7efa1d9a2e5e5b"},"es":{"assetId":"G678L1KTS01.xml","path":"HELP_KEYTERMS/KT/XML/L1KTS01.xml","sha256":"3b437b42e75536fa8b4f110325e366c27fbe10a871439d4797650cda4238b407"}},"sourceEntrySha256":{"en":"12235e57350acdfb7139b8c73c95201627bb5968e6e21c00790c8ad70a0a2754","es":"d75f7b30bdd044da023b462acfee13e5fd995d2ae623f2809c2649e8bd4f7802"},"extractionLfNormalizedEntrySha256":{"en":"12235e57350acdfb7139b8c73c95201627bb5968e6e21c00790c8ad70a0a2754","es":"d75f7b30bdd044da023b462acfee13e5fd995d2ae623f2809c2649e8bd4f7802"}}],"sourceEntriesVerified":true,"sourceDictionaryFilesModified":false,"resolver":{"path":"scripts/build-g678-a