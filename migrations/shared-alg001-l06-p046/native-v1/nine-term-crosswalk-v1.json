    {
      "id": "equation",
      "sourceKeyAttribute": "Equation",
      "labels": {
        "en": "Equation",
        "es": "Ecuación"
      },
      "definitions": {
        "en": "A mathematical sentence where both sides of the equal sign (=) have the same value (are equal). For example: 9 + 9 = 3 x 6.",
        "es": "Enunciado de una igualdad en la cual ambos lados del signo igual (=) tienen el mismo valor (son iguales). Por ejemplo: 9 + 9 = 3 x 6."
      },
