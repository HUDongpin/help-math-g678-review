      "id": "input",
      "sourceKeyAttribute": "Input",
      "labels": {
        "en": "Input",
        "es": "Entrada"
      },
      "definitions": {
        "en": "In mathematics, input refers to putting data into something.",
        "es": "En matemáticas, entrada (ingreso) se refiere al acto de poner datos en en algo."
