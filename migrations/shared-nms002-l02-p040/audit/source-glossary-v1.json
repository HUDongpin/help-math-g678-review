    {
      "id": "denominator",
      "sourceKeyAttribute": "Denominator",
      "labels": {
        "en": "Denominator",
        "es": "Denominador"
      },
      "definitions": {
        "en": "The bottom number in a fraction. For example: 2 is the denominator of 1/2.",
        "es": "El número que aparece en la parte de abajo de una fracción. Por ejemplo: el 2 es el denominador de 1/2."
      },
